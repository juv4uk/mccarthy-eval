(DEFINE APP (LABEL APP (LAMBDA (X Y) (COND ((EQ X NIL) Y) (T (CONS (CAR X) (APP (CDR X) Y)))))))
(DEFINE DBL (LAMBDA (X) (APP X X)))
(DEFINE LAST (LABEL LAST (LAMBDA (X) (COND ((EQ (CDR X) NIL) (CAR X)) (T (LAST (CDR X)))))))
(LAST (DBL (DBL (DBL (DBL (DBL (DBL (DBL (DBL (DBL (DBL (QUOTE (A B)))))))))))))
